import { LineEdit, Palette, TextEdit } from "std-widgets.slint";
import { AppButton } from "../../public/components.slint";

export struct FolderStylePreviewRow {
  folder_path: string,
  info_tip_text: string,
  status_text: string,
}

export component FolderStyleEditorWindow inherits Window {
  title: root.tr("folderstyle.editor.title", root.language_index);
  icon: @image-url("../../../assets/icon.png");
  background: Palette.background;
  default-font-family: "Source Han Serif CN";
  preferred-width: 760px;
  preferred-height: 520px;
  min-width: 420px;
  min-height: 260px;

  in-out property <string> folder_path;
  in-out property <string> ini_content;
  in-out property <int> language_index;
  pure callback tr(string, int) -> string;

  callback accept_request(string);
  callback cancel_request();

  blur_focus := FocusScope {
    focus-on-tab-navigation: false;
  }

  TouchArea {
    width: root.width;
    height: root.height;

    clicked => {
      blur_focus.focus();
    }
  }

  VerticalLayout {
    padding: 14px;
    spacing: 12px;

    HorizontalLayout {
      spacing: 8px;
      Text {
        text: root.tr("folderstyle.editor.folder", root.language_index);
        color: Palette.foreground;
        vertical-alignment: center;
      }
      Text {
        text: root.folder_path;
        font-weight: 600;
        color: Palette.alternate-foreground;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: no-wrap;
        overflow: elide;
      }
    }

    Rectangle {
      border-width: 1px;
      border-color: Palette.border;
      border-radius: 8px;
      background: Palette.background;
      vertical-stretch: 1;

      Text {
        text: root.tr("folderstyle.editor.desktop_ini", root.language_index);
        x: 12px;
        y: 10px;
        font-weight: 600;
        color: Palette.foreground;
      }

      TextEdit {
        x: 8px;
        y: 36px;
        width: parent.width - 16px;
        height: parent.height - 44px;
        text <=> root.ini_content;
        wrap: char-wrap;
      }
    }

    HorizontalLayout {
      spacing: 8px;
      Rectangle { horizontal-stretch: 1; }
      AppButton {
        text: root.tr("folderstyle.editor.ok", root.language_index);
        min-width: 96px;
        clicked => {
          root.accept_request(root.ini_content);
        }
        vertical-stretch: 0;
      }
      AppButton {
        text: root.tr("folderstyle.editor.cancel", root.language_index);
        min-width: 96px;
        clicked => {
          root.cancel_request();
        }
        vertical-stretch: 0;
      }
    }
  }
}

component FolderStyleGroupButton inherits Rectangle {
  in property <string> label;
  in property <int> index;
  in property <int> selected_index;
  callback clicked(int);

  min-width: 0px;
  height: 30px;
  horizontal-stretch: 1;

  AppButton {
    width: parent.width;
    height: parent.height;
    text: root.label;
    enabled: root.selected_index != root.index;
    clicked => {
      root.clicked(root.index);
    }
    vertical-stretch: 0;
  }
}

export component FolderStylePanel inherits VerticalLayout {
  in-out property <string> folder_path;
  in-out property <string> status_text;
  in-out property <string> preview_text;
  in-out property <[FolderStylePreviewRow]> preview_rows;
  in-out property <int> selected_group_index;
  in-out property <int> language_index;
  pure callback tr(string, int) -> string;

  callback group_request(int);
  callback pick_folder(string) -> string;
  callback add_request(string);
  callback move_up_request(int);
  callback edit_row_request(int);
  callback remove_row_request(int);
  callback clear_request();
  callback apply_request();

  spacing: 12px;

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    vertical-stretch: 0;

    VerticalLayout {
      padding: 12px;
      spacing: 10px;

      HorizontalLayout {
        spacing: 6px;
        Text {
          text: root.tr("folderstyle.group_label", root.language_index);
          color: Palette.foreground;
          vertical-alignment: center;
        }
        FolderStyleGroupButton {
          label: "I";
          index: 0;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "II";
          index: 1;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "III";
          index: 2;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "IV";
          index: 3;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "V";
          index: 4;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "VI";
          index: 5;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "VII";
          index: 6;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "VIII";
          index: 7;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "IX";
          index: 8;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
        FolderStyleGroupButton {
          label: "X";
          index: 9;
          selected_index: root.selected_group_index;
          clicked(index) => { root.group_request(index); }
        }
      }

      HorizontalLayout {
        spacing: 8px;
        Text {
          text: root.tr("folderstyle.folder_label", root.language_index);
          color: Palette.foreground;
          vertical-alignment: center;
        }
        LineEdit {
          text <=> root.folder_path;
          min-width: 220px;
          horizontal-stretch: 1;
        }
        AppButton {
          text: root.tr("folderstyle.browse", root.language_index);
          min-width: 96px;
          clicked => {
            let selected = root.pick_folder(root.folder_path);
            if (selected != "") {
              root.folder_path = selected;
            }
          }
          vertical-stretch: 0;
        }
      }

      HorizontalLayout {
        spacing: 8px;
        AppButton {
          text: root.tr("folderstyle.add", root.language_index);
          min-width: 96px;
          horizontal-stretch: 1;
          clicked => {
            root.add_request(root.folder_path);
          }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("folderstyle.clear", root.language_index);
          min-width: 96px;
          horizontal-stretch: 1;
          clicked => {
            root.clear_request();
          }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("folderstyle.apply", root.language_index);
          min-width: 96px;
          horizontal-stretch: 1;
          clicked => {
            root.apply_request();
          }
          vertical-stretch: 0;
        }
      }
    }
  }

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    vertical-stretch: 3;

    Text {
      text: root.tr("folderstyle.log", root.language_index);
      x: 12px;
      y: 10px;
      font-weight: 600;
      color: Palette.foreground;
    }

    Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: parent.height - 35px;
      background: Palette.background;

      TextEdit {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        text: root.status_text;
        read-only: true;
        wrap: char-wrap;
      }
    }
  }

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    clip: true;
    vertical-stretch: 7;

    Text {
      text: root.tr("folderstyle.preview_title", root.language_index);
      x: 12px;
      y: 10px;
      font-weight: 600;
      color: Palette.foreground;
    }

    if (root.preview_text != ""): Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: parent.height - 35px;
      background: Palette.control-background;

      TextEdit {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        text: root.preview_text;
        read-only: true;
        wrap: char-wrap;
      }
    }

    if (root.preview_text == ""): Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: 28px;
      background: Palette.control-background;

      HorizontalLayout {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        Rectangle {
          horizontal-stretch: 1;
          clip: true;
          Text {
            text: root.tr("folderstyle.table.folder", root.language_index);
            width: parent.width;
            font-weight: 600;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
          }
        }
        Rectangle {
          width: 240px;
          clip: true;
          Text {
            text: root.tr("folderstyle.table.note", root.language_index);
            width: parent.width;
            font-weight: 600;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
          }
        }
        Text {
          text: root.tr("folderstyle.table.status", root.language_index);
          width: 108px;
          font-weight: 600;
          color: Palette.foreground;
          vertical-alignment: center;
          wrap: no-wrap;
          overflow: elide;
        }
        Text {
          text: "";
          width: 280px;
        }
      }
    }

    if (root.preview_text == ""): Flickable {
      x: 1px;
      y: 63px;
      width: parent.width - 2px;
      height: parent.height - 64px;
      viewport-width: self.width;
      viewport-height: preview_table.preferred-height + 8px;

      preview_table := VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        spacing: 2px;

        for row[i] in root.preview_rows : Rectangle {
          width: parent.width;
          min-height: 30px;
          background: Palette.background;

          HorizontalLayout {
            spacing: 8px;
            padding-left: 8px;
            padding-right: 8px;
            Rectangle {
              horizontal-stretch: 1;
              clip: true;
              LineEdit {
                text: row.folder_path;
                read-only: true;
                width: parent.width;
              }
            }
            Rectangle {
              width: 240px;
              clip: true;
              LineEdit {
                text: row.info_tip_text;
                read-only: true;
                width: parent.width;
              }
            }
            LineEdit {
              text: row.status_text;
              read-only: true;
              width: 108px;
            }
            AppButton {
              text: root.tr("folderstyle.move_up", root.language_index);
              width: 88px;
              enabled: i > 0;
              clicked => {
                root.move_up_request(i);
              }
              vertical-stretch: 0;
            }
            AppButton {
              text: root.tr("common.edit", root.language_index);
              width: 88px;
              clicked => {
                root.edit_row_request(i);
              }
              vertical-stretch: 0;
            }
            AppButton {
              text: root.tr("common.remove", root.language_index);
              width: 88px;
              clicked => {
                root.remove_row_request(i);
              }
              vertical-stretch: 0;
            }
          }
        }
      }
    }
  }
}


