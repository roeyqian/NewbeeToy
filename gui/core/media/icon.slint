import { LineEdit, Palette, TextEdit } from "std-widgets.slint";
import { AppButton } from "../../components.slint";

export struct IconPreviewRow {
  source_name: string,
  ico_name: string,
  status_text: string,
  has_error: bool,
}

export component IconPanel inherits VerticalLayout {
  in-out property <string> source_path;
  in-out property <string> output_path;
  in-out property <string> status_text;
  in-out property <string> preview_text;
  in-out property <[IconPreviewRow]> preview_rows;
  in-out property <int> language_index;
  pure callback tr(string, int) -> string;

  callback pick_input_folder(string) -> string;
  callback pick_input_file(string) -> string;
  callback pick_output_folder(string) -> string;
  callback scan_request(string);
  callback extract_request(string);
  callback remove_row_request(int);
  callback clear_request();

  spacing: 12px;

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    vertical-stretch: 0;

    VerticalLayout {
      padding: 12px;
      spacing: 10px;

      HorizontalLayout {
        spacing: 8px;
        Text {
          text: root.tr("icon.input_label", root.language_index);
          color: Palette.foreground;
          vertical-alignment: center;
        }
        LineEdit {
          text <=> root.source_path;
          min-width: 220px;
          horizontal-stretch: 1;
        }
        AppButton {
          text: root.tr("icon.browse_folder", root.language_index);
          min-width: 128px;
          preferred-width: 128px;
          max-width: 128px;
          clicked => {
            let selected = root.pick_input_folder(root.source_path);
            if (selected != "") {
              root.source_path = selected;
            }
          }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("icon.browse_file", root.language_index);
          min-width: 128px;
          preferred-width: 128px;
          max-width: 128px;
          clicked => {
            let selected = root.pick_input_file(root.source_path);
            if (selected != "") {
              root.source_path = selected;
            }
          }
          vertical-stretch: 0;
        }
      }

      HorizontalLayout {
        spacing: 8px;
        Text {
          text: root.tr("icon.output_label", root.language_index);
          color: Palette.foreground;
          vertical-alignment: center;
        }
        LineEdit {
          text <=> root.output_path;
          min-width: 220px;
          horizontal-stretch: 1;
        }
        AppButton {
          text: root.tr("icon.browse_folder", root.language_index);
          min-width: 128px;
          preferred-width: 128px;
          max-width: 128px;
          clicked => {
            let selected = root.pick_output_folder(root.output_path);
            if (selected != "") {
              root.output_path = selected;
            }
          }
          vertical-stretch: 0;
        }
      }

      HorizontalLayout {
        spacing: 8px;
        AppButton {
          text: root.tr("icon.scan", root.language_index);
          min-width: 128px;
          horizontal-stretch: 1;
          clicked => {
            root.scan_request(root.source_path);
          }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("icon.extract", root.language_index);
          min-width: 128px;
          horizontal-stretch: 1;
          clicked => {
            root.extract_request(root.output_path);
          }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("icon.clear", root.language_index);
          min-width: 128px;
          horizontal-stretch: 1;
          clicked => {
            root.clear_request();
          }
          vertical-stretch: 0;
        }
      }
    }
  }

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    vertical-stretch: 3;

    Text {
      text: root.tr("icon.log", root.language_index);
      x: 12px;
      y: 10px;
      font-weight: 700;
      color: Palette.foreground;
    }

    Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: parent.height - 35px;
      background: Palette.background;

      status_body := TextEdit {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        text: root.status_text;
        read-only: true;
        wrap: char-wrap;
      }
    }
  }

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    clip: true;
    vertical-stretch: 7;

    Text {
      text: root.tr("icon.preview_title", root.language_index);
      x: 12px;
      y: 10px;
      font-weight: 700;
      color: Palette.foreground;
    }

    if (root.preview_text != ""): Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: parent.height - 35px;
      background: Palette.control-background;

      preview_message := TextEdit {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        text: root.preview_text;
        read-only: true;
        wrap: char-wrap;
      }
    }

    if (root.preview_text == ""): Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: 28px;
      background: Palette.control-background;

      HorizontalLayout {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        Text {
          text: root.tr("icon.table.source", root.language_index);
          width: 250px;
          font-weight: 700;
          color: Palette.foreground;
          vertical-alignment: center;
          wrap: no-wrap;
          overflow: elide;
        }
        Rectangle {
          horizontal-stretch: 1;
          clip: true;
          Text {
            text: root.tr("icon.table.ico", root.language_index);
            width: parent.width;
            font-weight: 700;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
          }
        }
        Text {
          text: root.tr("icon.table.status", root.language_index);
          width: 160px;
          font-weight: 700;
          color: Palette.foreground;
          vertical-alignment: center;
          wrap: no-wrap;
          overflow: elide;
        }
        Text {
          text: "";
          width: 128px;
        }
      }
    }

    if (root.preview_text == ""): Flickable {
      x: 1px;
      y: 63px;
      width: parent.width - 2px;
      height: parent.height - 64px;
      viewport-width: self.width;
      viewport-height: preview_table.preferred-height + 8px;

      preview_table := VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        spacing: 2px;

        for row[i] in root.preview_rows : Rectangle {
          width: parent.width;
          min-height: 30px;
          background: Palette.background;

          HorizontalLayout {
            spacing: 8px;
            padding-left: 8px;
            padding-right: 8px;
              LineEdit {
                text: row.source_name;
                read-only: true;
                width: 250px;
              }
            Rectangle {
              horizontal-stretch: 1;
              clip: true;
              LineEdit {
                text: row.ico_name;
                read-only: true;
                width: parent.width;
              }
            }
            LineEdit {
              text: row.status_text;
              read-only: true;
              width: 160px;
            }
            AppButton {
              text: root.tr("common.remove", root.language_index);
              min-width: 128px;
              preferred-width: 128px;
              max-width: 128px;
              clicked => {
                root.remove_row_request(i);
              }
              vertical-stretch: 0;
            }
          }
        }
      }
    }
  }
}


