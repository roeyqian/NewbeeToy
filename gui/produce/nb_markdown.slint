import { LineEdit, Palette, TextEdit } from "std-widgets.slint";
import { AppButton } from "../components.slint";

export struct MarkdownPreviewRow {
  source_name: string,
  light_html_name: string,
  dark_html_name: string,
  status_text: string,
  has_error: bool,
}

export component MarkdownPanel inherits VerticalLayout {
  in-out property <string> source_path;
  in-out property <string> output_path;
  in-out property <string> status_text;
  in-out property <[MarkdownPreviewRow]> preview_rows;
  in-out property <int> language_index;
  pure callback tr(string, int) -> string;

  callback pick_input_folder(string) -> string;
  callback pick_input_file(string) -> string;
  callback pick_output_folder(string) -> string;
  callback scan_request(string);
  callback export_request(string);
  callback remove_row_request(int);
  callback clear_request();

  spacing: 12px;

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    vertical-stretch: 0;

    VerticalLayout {
      padding: 12px;
      spacing: 10px;

      HorizontalLayout {
        spacing: 8px;
        Text {
          text: root.tr("markdown.input_label", root.language_index);
          color: Palette.foreground;
          vertical-alignment: center;
        }
        LineEdit {
          text <=> root.source_path;
          min-width: 220px;
          horizontal-stretch: 1;
        }
        AppButton {
          text: root.tr("markdown.browse_folder", root.language_index);
          min-width: 128px;
          preferred-width: 128px;
          max-width: 128px;
          clicked => {
            let selected = root.pick_input_folder(root.source_path);
            if (selected != "") { root.source_path = selected; }
          }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("markdown.browse_file", root.language_index);
          min-width: 128px;
          preferred-width: 128px;
          max-width: 128px;
          clicked => {
            let selected = root.pick_input_file(root.source_path);
            if (selected != "") { root.source_path = selected; }
          }
          vertical-stretch: 0;
        }
      }

      HorizontalLayout {
        spacing: 8px;
        Text {
          text: root.tr("markdown.output_label", root.language_index);
          color: Palette.foreground;
          vertical-alignment: center;
        }
        LineEdit {
          text <=> root.output_path;
          min-width: 220px;
          horizontal-stretch: 1;
        }
        AppButton {
          text: root.tr("markdown.browse_folder", root.language_index);
          min-width: 128px;
          preferred-width: 128px;
          max-width: 128px;
          clicked => {
            let selected = root.pick_output_folder(root.output_path);
            if (selected != "") { root.output_path = selected; }
          }
          vertical-stretch: 0;
        }
      }

      HorizontalLayout {
        spacing: 8px;
        AppButton {
          text: root.tr("markdown.scan", root.language_index);
          min-width: 128px;
          horizontal-stretch: 1;
          clicked => { root.scan_request(root.source_path); }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("markdown.export", root.language_index);
          min-width: 128px;
          horizontal-stretch: 1;
          clicked => { root.export_request(root.output_path); }
          vertical-stretch: 0;
        }
        AppButton {
          text: root.tr("markdown.clear", root.language_index);
          min-width: 128px;
          horizontal-stretch: 1;
          clicked => { root.clear_request(); }
          vertical-stretch: 0;
        }
      }
    }
  }

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    min-width: 480px;
    min-height: 100px;
    vertical-stretch: 3;

    Text {
      text: root.tr("markdown.log", root.language_index);
      x: 12px;
      y: 10px;
      font-weight: 700;
      color: Palette.foreground;
    }

    TextEdit {
      x: 9px;
      y: 36px;
      width: parent.width - 18px;
      height: parent.height - 45px;
      text: root.status_text;
      read-only: true;
      wrap: char-wrap;
    }
  }

  Rectangle {
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: Palette.background;
    clip: true;
    min-width: 640px;
    min-height: 180px;
    vertical-stretch: 7;

    Text {
      text: root.tr("markdown.preview_title", root.language_index);
      x: 12px;
      y: 10px;
      font-weight: 700;
      color: Palette.foreground;
    }

    Rectangle {
      x: 1px;
      y: 34px;
      width: parent.width - 2px;
      height: 28px;
      background: Palette.control-background;

      HorizontalLayout {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        Text {
          text: root.tr("markdown.table.source", root.language_index);
          width: 180px;
          font-weight: 700;
          color: Palette.foreground;
          vertical-alignment: center;
          wrap: no-wrap;
          overflow: elide;
        }
        Rectangle {
          horizontal-stretch: 1;
          clip: true;
          Text {
            text: root.tr("markdown.table.light_html", root.language_index);
            width: parent.width;
            font-weight: 700;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
          }
        }
        Rectangle {
          horizontal-stretch: 1;
          clip: true;
          Text {
            text: root.tr("markdown.table.dark_html", root.language_index);
            width: parent.width;
            font-weight: 700;
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
          }
        }
        Text {
          text: root.tr("markdown.table.status", root.language_index);
          width: 120px;
          font-weight: 700;
          color: Palette.foreground;
          vertical-alignment: center;
          wrap: no-wrap;
          overflow: elide;
        }
        Text { text: ""; width: 128px; }
      }
    }

    Flickable {
      x: 1px;
      y: 63px;
      width: parent.width - 2px;
      height: parent.height - 64px;
      viewport-width: self.width;
      viewport-height: preview_table.preferred-height + 8px;

      preview_table := VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        spacing: 2px;

        for row[i] in root.preview_rows : Rectangle {
          width: parent.width;
          min-height: 30px;
          background: Palette.background;

          HorizontalLayout {
            spacing: 8px;
            padding-left: 8px;
            padding-right: 8px;
            LineEdit {
              text: row.source_name;
              read-only: true;
              width: 180px;
            }
            Rectangle {
              horizontal-stretch: 1;
              clip: true;
              LineEdit {
                text: row.light_html_name;
                read-only: true;
                width: parent.width;
              }
            }
            Rectangle {
              horizontal-stretch: 1;
              clip: true;
              LineEdit {
                text: row.dark_html_name;
                read-only: true;
                width: parent.width;
              }
            }
            LineEdit {
              text: row.status_text;
              read-only: true;
              width: 120px;
            }
            AppButton {
              text: root.tr("common.remove", root.language_index);
              min-width: 128px;
              preferred-width: 128px;
              max-width: 128px;
              clicked => { root.remove_row_request(i); }
              vertical-stretch: 0;
            }
          }
        }
      }
    }
  }
}
