import { CheckBox, Palette } from "std-widgets.slint";
import { AppButton } from "components.slint";
import { PresetManagerWindow, PresetEntry } from "presets.slint";
import { FolderStylePanel, FolderStylePreviewRow, FolderStyleEditorWindow } from "general/nb_folderstyle.slint";
import { RenamePanel, RenamePreviewRow } from "general/nb_rename.slint";
import { UnlockPanel, UnlockPreviewRow } from "general/nb_unlock.slint";
import { IconPanel, IconPreviewRow } from "produce/nb_icon.slint";
import { MarkdownPanel, MarkdownPreviewRow } from "produce/nb_markdown.slint";
