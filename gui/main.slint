export { FolderStyleEditorWindow } from "general/nb_folderstyle.slint";
export { PresetManagerWindow, PresetEntry } from "presets.slint";
export { SysenvValueEditorWindow, SysenvValueEntry } from "system/nb_sysenv.slint";

component ElideButton inherits Rectangle {
  in property <string> label;
  in property <bool> enabled: true;
  callback clicked;

  min-width: 28px;
  preferred-width: 90px;
  max-width: self.preferred-width;
  height: 30px;
  background: #00000000;
  clip: true;

  AppButton {
    width: parent.width;
    height: parent.height;
    text: "";
    enabled: root.enabled;
    clicked => {
      root.clicked();
    }
  }

  Text {
    x: 10px;
    y: 0px;
    width: parent.width - 20px;
    height: parent.height;
    text: root.label;
    color: root.enabled ? Palette.foreground : #808080;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: no-wrap;
    overflow: elide;
  }
}

component ElideCheckBox inherits Rectangle {
  in property <string> label;
  in-out property <bool> checked;
  in property <bool> enabled: true;
  callback toggled;

  min-width: 46px;
  preferred-width: checkbox_label.preferred-width + 28px;
  max-width: self.preferred-width;
  height: 30px;
  background: #00000000;
  clip: true;

  Rectangle {
    x: 0px;
    width: 20px;
    height: parent.height;
    clip: true;

    CheckBox {
      width: 20px;
      height: parent.height;
      text: "";
      checked <=> root.checked;
      enabled: root.enabled;
      toggled => {
        root.toggled();
      }
    }
  }

  checkbox_label := Text {
    x: 28px;
    y: 0px;
    width: parent.width - 28px;
    height: parent.height;
    text: root.label;
    color: root.enabled ? Palette.foreground : #808080;
    vertical-alignment: center;
    wrap: no-wrap;
    overflow: elide;
  }

  TouchArea {
    x: 20px;
    y: 0px;
    width: parent.width - 20px;
    height: parent.height;
    enabled: root.enabled;
    clicked => {
      root.checked = !root.checked;
      root.toggled();
    }
  }
}

component ThemeDrawerButton inherits Rectangle {
  in property <string> label;
  in property <string> auto_label;
  in property <string> dark_label;
  in property <string> light_label;
  in property <int> selected_index;
  callback theme_selected(int);
  private property <bool> drawer_open: false;

  min-width: 28px;
  preferred-width: 90px;
  max-width: self.preferred-width;
  height: 30px;
  background: #00000000;
  clip: true;

  AppButton {
    width: parent.width;
    height: parent.height;
    text: "";
    clicked => {
      drawer_open_timer.running = false;
      root.drawer_open = false;
      theme_drawer.show();
      drawer_open_timer.running = true;
    }
  }

  Text {
    x: 10px;
    y: 0px;
    width: parent.width - 20px;
    height: parent.height;
    text: root.label;
    color: Palette.foreground;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: no-wrap;
    overflow: elide;
  }

  theme_drawer := PopupWindow {
    x: 0px;
    y: -110px;
    width: 248px;
    height: 102px;
    close-policy: close-on-click-outside;

    Rectangle {
      y: root.drawer_open ? 0px : 18px;
      border-width: 1px;
      border-color: Palette.border;
      border-radius: 8px;
      background: Palette.background == #1C1C1C ? #2A2A2A : #FEFEFE;

      animate y {
        duration: 180ms;
        easing: ease-out;
      }

      TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
          theme_drawer.close();
        }
      }

      VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Text {
          text: root.label;
          font-size: 16px;
          font-weight: 700;
          color: Palette.alternate-foreground;
          vertical-alignment: center;
        }

        HorizontalLayout {
          spacing: 8px;
          AppButton {
            text: root.auto_label;
            height: root.height;
            enabled: root.selected_index != 0;
            clicked => {
              root.theme_selected(0);
              theme_drawer.close();
            }
          }
          AppButton {
            text: root.dark_label;
            height: root.height;
            enabled: root.selected_index != 1;
            clicked => {
              root.theme_selected(1);
              theme_drawer.close();
            }
          }
          AppButton {
            text: root.light_label;
            height: root.height;
            enabled: root.selected_index != 2;
            clicked => {
              root.theme_selected(2);
              theme_drawer.close();
            }
          }
        }
      }
    }
  }

  drawer_open_timer := Timer {
    interval: 16ms;
    running: false;
    triggered => {
      root.drawer_open = true;
      self.running = false;
    }
  }

}

// Unlike the platform ScrollView, this reserves both scrollbar lanes at all
// times. The thumb remains hidden until its corresponding axis overflows.
component FixedScrollBar inherits Rectangle {
  in property <bool> horizontal;
  in property <length> maximum;
  in property <length> page-size;
  in-out property <length> value;
  in property <bool> enabled: true;
  callback scrolled;

  private property <bool> can-scroll: root.maximum > 0px;

  background: Palette.control-background;
  border-width: 1px;
  border-color: Palette.border;
  clip: true;

  thumb := Rectangle {
    visible: root.can-scroll;
    x: root.horizontal
      ? (parent.width - self.width) * (-root.value / root.maximum)
      : (parent.width - self.width) / 2;
    y: root.horizontal
      ? (parent.height - self.height) / 2
      : (parent.height - self.height) * (-root.value / root.maximum);
    width: root.horizontal
      ? max(20px, parent.width * root.page-size / (root.maximum + root.page-size))
      : min(8px, parent.width);
    height: root.horizontal
      ? min(8px, parent.height)
      : max(20px, parent.height * root.page-size / (root.maximum + root.page-size));
    border-radius: 4px;
    background: Palette.border;
  }

  touch-area := TouchArea {
    property <{pressed-value: length, maximum: length, x: length, y: length}> saved-values;

    width: parent.width;
    height: parent.height;
    enabled: root.enabled && root.can-scroll;

    function update-saved-values() {
      self.saved-values = {
        pressed-value: -root.value,
        maximum: root.maximum,
        x: self.mouse-x,
        y: self.mouse-y,
      };
    }

    pointer-event(event) => {
      if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
        self.update-saved-values();
      }
    }

    moved => {
      if (self.enabled && self.pressed) {
        if (self.saved-values.maximum != root.maximum) {
          self.update-saved-values();
        }

        root.value = -max(0px, min(root.maximum, self.saved-values.pressed-value + (
          root.horizontal
            ? (self.mouse-x - self.saved-values.x) * (root.maximum / (root.width - thumb.width))
            : (self.mouse-y - self.saved-values.y) * (root.maximum / (root.height - thumb.height))
        )));
        root.scrolled();
      }
    }

    scroll-event(event) => {
      if (root.horizontal && event.delta-x != 0) {
        root.value = max(-root.maximum, min(0px, root.value + event.delta-x));
        return accept;
      } else if (!root.horizontal && event.delta-y != 0) {
        root.value = max(-root.maximum, min(0px, root.value + event.delta-y));
        return accept;
      }
      reject
    }
  }
}

component FixedScrollView inherits Rectangle {
  in property <bool> enabled: true;
  out property <length> visible-width <=> flickable.width;
  out property <length> visible-height <=> flickable.height;
  in-out property <length> viewport-width <=> flickable.viewport-width;
  in-out property <length> viewport-height <=> flickable.viewport-height;
  in-out property <length> viewport-x <=> flickable.viewport-x;
  in-out property <length> viewport-y <=> flickable.viewport-y;
  in property <bool> mouse-drag-pan-enabled <=> flickable.interactive;
  callback scrolled <=> flickable.flicked;

  private property <length> scrollbar-size: 14px;

  flickable := Flickable {
    x: 0px;
    y: 0px;
    width: max(0px, parent.width - root.scrollbar-size);
    height: max(0px, parent.height - root.scrollbar-size);
    viewport-y <=> vertical-bar.value;
    viewport-x <=> horizontal-bar.value;

    @children
  }

  vertical-bar := FixedScrollBar {
    x: flickable.x + flickable.width;
    y: flickable.y;
    width: root.scrollbar-size;
    height: flickable.height;
    horizontal: false;
    maximum: max(0px, flickable.viewport-height - flickable.height);
    page-size: flickable.height;
    enabled: root.enabled;
    scrolled => { root.scrolled(); }
  }

  horizontal-bar := FixedScrollBar {
    x: flickable.x;
    y: flickable.y + flickable.height;
    width: flickable.width;
    height: root.scrollbar-size;
    horizontal: true;
    maximum: max(0px, flickable.viewport-width - flickable.width);
    page-size: flickable.width;
    enabled: root.enabled;
    scrolled => { root.scrolled(); }
  }

  Rectangle {
    x: flickable.x + flickable.width;
    y: flickable.y + flickable.height;
    width: root.scrollbar-size;
    height: root.scrollbar-size;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
  }
}

export component MainWindow inherits Window {
  title: "NewbeeToy";
  icon: @image-url("../assets/icon.png");
  background: Palette.background;
  default-font-family: "Noto Serif SC";
  preferred-width: 940px;
  preferred-height: 620px;
  // Keep a practical native window minimum. Scrollbar visibility is determined
  // by the active page's measured preferred layout size, not these limits.
  min-width: 320px;
  min-height: 240px;

  private property <length> ui_button_height: 30px;
  private property <length> settings_button_width: 90px;
  private property <length> clear_logs_button_width: 135px;
  private property <length> language_button_width: 72px;
  in-out property <int> page_index: 0;
  in-out property <int> category_index: 0;
  in-out property <string> folder_path;
  in-out property <string> find_text;
  in-out property <string> replace_text;
  in-out property <bool> use_regex;
  in-out property <bool> case_sensitive: true;
  in-out property <bool> count_syntax: false;
  in-out property <string> status_text: "";
  in-out property <string> preview_text: "";
  in-out property <[RenamePreviewRow]> preview_rows: [];
  in-out property <bool> preview_has_error: false;
  in-out property <string> icon_source_path;
  in-out property <string> icon_output_path;
  in-out property <string> icon_status_text: "";
  in-out property <string> icon_preview_text: "";
  in-out property <[IconPreviewRow]> icon_preview_rows: [];
  in-out property <string> markdown_source_path;
  in-out property <string> markdown_output_path;
  in-out property <string> markdown_status_text: "";
  in-out property <[MarkdownPreviewRow]> markdown_preview_rows: [];
  in-out property <string> unlock_target_path;
  in-out property <string> unlock_status_text: "";
  in-out property <string> unlock_preview_text: "";
  in-out property <[UnlockPreviewRow]> unlock_preview_rows: [];
  in-out property <bool> unlock_scanning: false;
  in-out property <string> folderstyle_folder_path;
  in-out property <string> folderstyle_status_text: "";
  in-out property <string> folderstyle_preview_text: "";
  in-out property <[FolderStylePreviewRow]> folderstyle_preview_rows: [];
  in-out property <string> folderstyle_preset_name;
  in-out property <string> sysenv_value_path;
  in-out property <string> sysenv_preset_name;
  in-out property <string> sysenv_variable_name;
  in-out property <string> sysenv_status_text: "";
  in-out property <string> sysenv_preview_text: "";
  in-out property <[SysenvPreviewRow]> sysenv_preview_rows: [];
  in-out property <int> language_index: 0;
  in-out property <int> theme_index: 0;
  in-out property <bool> lock_window: false;
  in-out property <string> app_version: "";

  pure callback tr(string, int) -> string;
  callback set_language_request(int);
  callback set_theme_request(int);
  callback set_window_lock_request(bool);
  callback clear_logs_request();
  callback open_help_request();
  callback open_feature_request(int);
  callback pick_folder(string) -> string;
  callback read_directory_request(string);
  callback apply_changes_request(string, string, string, bool, bool, bool);
  callback remove_preview_row_request(int);
  callback clear_preview_request();
  callback apply_request();
  callback undo_request();
  callback pick_icon_file(string) -> string;
  callback pick_markdown_file(string) -> string;
  callback icon_scan_request(string);
  callback icon_extract_request(string);
  callback icon_remove_row_request(int);
  callback icon_clear_request();
  callback markdown_scan_request(string);
  callback markdown_export_request(string);
  callback markdown_remove_row_request(int);
  callback markdown_clear_request();
  callback pick_unlock_file(string) -> string;
  callback pick_unlock_folder(string) -> string;
  callback unlock_scan_request(string);
  callback unlock_release_request();
  callback unlock_remove_row_request(int);
  callback unlock_clear_request();
  callback folderstyle_store_request(string);
  callback folderstyle_show_preset_manager_request();
  callback folderstyle_add_request(string);
  callback folderstyle_move_up_request(int);
  callback folderstyle_edit_row_request(int);
  callback folderstyle_remove_row_request(int);
  callback folderstyle_clear_request();
  callback folderstyle_apply_request();
  callback sysenv_enter_request();
  callback sysenv_interaction_request();
  callback sysenv_store_request(string);
  callback sysenv_show_preset_manager_request();
  callback sysenv_load_system_request();
  callback sysenv_load_user_request();
  callback sysenv_preview_request(string, string);
  callback sysenv_edit_row_request(int);
  callback sysenv_remove_row_request(int);
  callback sysenv_commit_system_request();
  callback sysenv_commit_user_request();

  changed theme_index => {
    Palette.color-scheme = root.theme_index == 1
      ? ColorScheme.dark
      : (root.theme_index == 2 ? ColorScheme.light : ColorScheme.unknown);
  }

  blur_focus := FocusScope {
    focus-on-tab-navigation: false;
  }

  TouchArea {
    width: root.width;
    height: root.height;

    clicked => {
      blur_focus.focus();
    }
  }

  content_scroll := FixedScrollView {
    width: root.width;
    height: root.height;
    mouse-drag-pan-enabled: false;
    // Use the active layout's preferred dimensions. This keeps every control at
    // its intended size and updates the scrollbars when the page or language changes.
    viewport-width: max(content_scroll.visible-width, content.preferred-width);
    viewport-height: max(content_scroll.visible-height, content.preferred-height);

    content := VerticalLayout {
      width: content_scroll.viewport-width;
      height: content_scroll.viewport-height;
      padding: 20px;
      spacing: 14px;

    HorizontalLayout {
      spacing: 12px;
      if (page_index == 0): HorizontalLayout {
        spacing: 8px;
        title_text := Text {
          text: "Newbee Toy";
          font-size: 25px;
          font-weight: 700;
          color: Palette.foreground;
          vertical-alignment: center;
          horizontal-stretch: 0;
        }
        Rectangle {
          min-width: version_text.preferred-width;
          preferred-width: version_text.preferred-width;
          max-width: self.preferred-width;
          height: title_text.preferred-height;
          background: #00000000;
          horizontal-stretch: 0;
          vertical-stretch: 0;

          version_text := Text {
            y: parent.height - self.preferred-height;
            text: root.app_version;
            font-size: 17px;
            font-weight: 400;
            color: Palette.foreground;
            vertical-alignment: bottom;
            horizontal-stretch: 0;
          }
        }
      }
      if (page_index != 0): Text {
        text: page_index == 1
          ? "Newbee Rename"
          : (page_index == 2
            ? "Newbee Icon"
            : (page_index == 3
              ? "Newbee Unlock"
              : (page_index == 4
                ? "Newbee System Environment"
                : "Newbee Folder Style")));
        font-size: 25px;
        font-weight: 700;
        color: Palette.foreground;
        vertical-alignment: center;
      }
      Rectangle { horizontal-stretch: 1; }
      if (page_index != 0): AppButton {
        text: root.tr("main.back", root.language_index);
        min-width: 64px;
        preferred-width: 128px;
        max-width: 128px;
        horizontal-stretch: 0;
        clicked => {
          root.page_index = 0;
        }
        vertical-stretch: 0;
      }
    }

    if (page_index == 0): VerticalLayout {
      spacing: 14px;

      HorizontalLayout {
        spacing: 14px;

        Rectangle {
          min-width: 178px;
          border-width: 1px;
          border-color: Palette.border;
          border-radius: 8px;
          background: Palette.control-background;

          VerticalLayout {
            padding: 12px;
            spacing: 9px;
            Text {
              text: root.tr("main.categories", root.language_index);
              font-size: 16px;
              font-weight: 700;
              color: Palette.alternate-foreground;
            }
            AppButton {
              text: root.tr("main.category.general", root.language_index);
              clicked => {
                root.category_index = 0;
              }
              enabled: root.category_index != 0;
              vertical-stretch: 0;
            }
            AppButton {
              text: root.tr("main.category.produce", root.language_index);
              clicked => {
                root.category_index = 1;
              }
              enabled: root.category_index != 1;
              vertical-stretch: 0;
            }
            AppButton {
              text: root.tr("main.category.system", root.language_index);
              clicked => {
                root.category_index = 2;
              }
              enabled: root.category_index != 2;
              vertical-stretch: 0;
            }
            Rectangle { vertical-stretch: 1; }
          }
        }

        Rectangle {
          background: #00000000;
          horizontal-stretch: 1;

          VerticalLayout {
            padding: 0px;
            spacing: 12px;

            Text {
              text: root.category_index == 0
                ? root.tr("main.tools.general", root.language_index)
                : (root.category_index == 1
                  ? root.tr("main.tools.produce", root.language_index)
                  : root.tr("main.tools.system", root.language_index));
              font-size: 18px;
              font-weight: 700;
              color: Palette.foreground;
            }

            if (root.category_index == 0): Rectangle {
              border-width: 1px;
              border-color: Palette.border;
              border-radius: 8px;
              background: Palette.control-background;
              min-height: 116px;

              VerticalLayout {
                padding: 14px;
                spacing: 9px;
                Text {
                  text: "Newbee Rename";
                  font-size: 18px;
                  font-weight: 700;
                  color: Palette.alternate-foreground;
                }
                Text {
                  text: root.tr("main.rename.desc", root.language_index);
                  wrap: char-wrap;
                  color: Palette.foreground;
                }
                AppButton {
                  text: root.tr("main.open", root.language_index);
                  height: root.ui_button_height;
                  clicked => {
                    root.open_feature_request(1);
                  }
                  vertical-stretch: 0;
                }
              }
            }

            if (root.category_index == 0): Rectangle {
              border-width: 1px;
              border-color: Palette.border;
              border-radius: 8px;
              background: Palette.control-background;
              min-height: 116px;

              VerticalLayout {
                padding: 14px;
                spacing: 9px;
                Text {
                  text: "Newbee Unlock";
                  font-size: 18px;
                  font-weight: 700;
                  color: Palette.alternate-foreground;
                }
                Text {
                  text: root.tr("main.unlock.desc", root.language_index);
                  wrap: char-wrap;
                  color: Palette.foreground;
                }
                AppButton {
                  text: root.tr("main.open", root.language_index);
                  height: root.ui_button_height;
                  clicked => {
                    root.open_feature_request(3);
                  }
                  vertical-stretch: 0;
                }
              }
            }

            if (root.category_index == 0): Rectangle {
              border-width: 1px;
              border-color: Palette.border;
              border-radius: 8px;
              background: Palette.control-background;
              min-height: 116px;

              VerticalLayout {
                padding: 14px;
                spacing: 9px;
                Text {
                  text: "Newbee Folder Style";
                  font-size: 18px;
                  font-weight: 700;
                  color: Palette.alternate-foreground;
                }
                Text {
                  text: root.tr("main.folderstyle.desc", root.language_index);
                  wrap: char-wrap;
                  color: Palette.foreground;
                }
                AppButton {
                  text: root.tr("main.open", root.language_index);
                  height: root.ui_button_height;
                  clicked => {
                    root.open_feature_request(5);
                  }
                  vertical-stretch: 0;
                }
              }
            }

            if (root.category_index == 1): Rectangle {
              border-width: 1px;
              border-color: Palette.border;
              border-radius: 8px;
              background: Palette.control-background;
              min-height: 116px;

              VerticalLayout {
                padding: 14px;
                spacing: 9px;
                Text {
                  text: "Newbee Icon";
                  font-size: 18px;
                  font-weight: 700;
                  color: Palette.alternate-foreground;
                }
                Text {
                  text: root.tr("main.icon.desc", root.language_index);
                  wrap: char-wrap;
                  color: Palette.foreground;
                }
                AppButton {
                  text: root.tr("main.open", root.language_index);
                  height: root.ui_button_height;
                  clicked => {
                    root.open_feature_request(2);
                  }
                  vertical-stretch: 0;
                }
              }
            }

            if (root.category_index == 1): Rectangle {
              border-width: 1px;
              border-color: Palette.border;
              border-radius: 8px;
              background: Palette.control-background;
              min-height: 116px;

              VerticalLayout {
                padding: 14px;
                spacing: 9px;
                Text {
                  text: "Newbee Markdown";
                  font-size: 18px;
                  font-weight: 700;
                  color: Palette.alternate-foreground;
                }
                Text {
                  text: root.tr("main.markdown.desc", root.language_index);
                  wrap: char-wrap;
                  color: Palette.foreground;
                }
                AppButton {
                  text: root.tr("main.open", root.language_index);
                  height: root.ui_button_height;
                  clicked => {
                    root.open_feature_request(6);
                  }
                  vertical-stretch: 0;
                }
              }
            }

            if (root.category_index == 2): Rectangle {
              border-width: 1px;
              border-color: Palette.border;
              border-radius: 8px;
              background: Palette.control-background;
              min-height: 116px;

              VerticalLayout {
                padding: 14px;
                spacing: 9px;
                Text {
                  text: "Newbee System Environment";
                  font-size: 18px;
                  font-weight: 700;
                  color: Palette.alternate-foreground;
                }
                Text {
                  text: root.tr("main.sysenv.desc", root.language_index);
                  wrap: char-wrap;
                  color: Palette.foreground;
                }
                AppButton {
                  text: root.tr("main.open", root.language_index);
                  height: root.ui_button_height;
                  clicked => {
                    root.open_feature_request(4);
                  }
                  vertical-stretch: 0;
                }
              }
            }

            Rectangle { vertical-stretch: 1; }
          }
        }
      }

      Rectangle {
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 8px;
        background: Palette.control-background;
        min-height: 86px;
        vertical-stretch: 0;
        clip: true;

        VerticalLayout {
          padding-left: 12px;
          padding-right: 12px;
          padding-top: 8px;
          padding-bottom: 8px;
          spacing: 8px;

          HorizontalLayout {
            spacing: 8px;
            Text {
              text: root.tr("main.options", root.language_index);
              font-size: 16px;
              font-weight: 700;
              color: Palette.alternate-foreground;
              vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
          }

          HorizontalLayout {
            spacing: 8px;
            Rectangle {
              min-width: 0px;
              preferred-width: language_label.preferred-width;
              max-width: self.preferred-width;
              horizontal-stretch: 1;
              clip: true;
              language_label := Text {
                width: parent.width;
                height: parent.height;
                text: root.tr("main.language", root.language_index);
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
              }
            }
            ElideButton {
              label: "中文";
              preferred-width: root.language_button_width;
              height: root.ui_button_height;
              clicked => {
                root.set_language_request(0);
              }
              enabled: root.language_index != 0;
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            ElideButton {
              label: "English";
              preferred-width: root.language_button_width;
              height: root.ui_button_height;
              clicked => {
                root.set_language_request(1);
              }
              enabled: root.language_index != 1;
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            ElideButton {
              label: "日本語";
              preferred-width: root.language_button_width;
              height: root.ui_button_height;
              clicked => {
                root.set_language_request(2);
              }
              enabled: root.language_index != 2;
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            ElideButton {
              label: "Español";
              preferred-width: root.language_button_width;
              height: root.ui_button_height;
              clicked => {
                root.set_language_request(3);
              }
              enabled: root.language_index != 3;
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            Rectangle {
              min-width: 0px;
              preferred-width: 12px;
              max-width: 12px;
              horizontal-stretch: 1;
            }
            ElideCheckBox {
              label: root.tr("main.lock_window", root.language_index);
              checked <=> root.lock_window;
              toggled => {
                root.set_window_lock_request(self.checked);
              }
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            Rectangle {
              min-width: 0px;
              preferred-width: 16px;
              max-width: 16px;
              horizontal-stretch: 1;
            }
            ThemeDrawerButton {
              label: root.tr("main.theme.label", root.language_index);
              auto_label: root.tr("main.theme.auto", root.language_index);
              dark_label: root.tr("main.theme.dark", root.language_index);
              light_label: root.tr("main.theme.light", root.language_index);
              selected_index: root.theme_index;
              preferred-width: root.settings_button_width;
              theme_selected(theme_index) => {
                root.set_theme_request(theme_index);
              }
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            Rectangle {
              min-width: 0px;
              preferred-width: 16px;
              max-width: 16px;
              horizontal-stretch: 1;
            }
            ElideButton {
              label: root.tr("main.clear_logs", root.language_index);
              preferred-width: root.clear_logs_button_width;
              height: root.ui_button_height;
              clicked => {
                root.clear_logs_request();
              }
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            Rectangle { horizontal-stretch: 1; }
            ElideButton {
              label: root.tr("main.help", root.language_index);
              preferred-width: root.clear_logs_button_width;
              height: root.ui_button_height;
              clicked => {
                root.open_help_request();
              }
              horizontal-stretch: 1;
              vertical-stretch: 0;
            }
            Rectangle {
              min-width: 0px;
              preferred-width: copyright_text.preferred-width;
              max-width: self.preferred-width;
              horizontal-stretch: 1;
              clip: true;
              copyright_text := Text {
                width: parent.width;
                height: parent.height;
                text: root.tr("main.copyright", root.language_index);
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
              }
            }
          }

        }
      }
    }

    if (page_index == 1): RenamePanel {
      folder_path <=> root.folder_path;
      find_text <=> root.find_text;
      replace_text <=> root.replace_text;
      use_regex <=> root.use_regex;
      case_sensitive <=> root.case_sensitive;
      count_syntax <=> root.count_syntax;
      status_text <=> root.status_text;
      preview_text <=> root.preview_text;
      preview_rows <=> root.preview_rows;
      preview_has_error <=> root.preview_has_error;
      language_index <=> root.language_index;
      tr(text_key, is_en) => { return root.tr(text_key, is_en); }

      pick_folder(current_path) => { return root.pick_folder(current_path); }
      read_directory_request(folder) => {
        root.read_directory_request(folder);
      }
      apply_changes_request(folder, find, replace, regex_on, case_on, count_on) => {
        root.apply_changes_request(folder, find, replace, regex_on, case_on, count_on);
      }
      clear_preview_request => {
        root.clear_preview_request();
      }
      remove_preview_row_request(index) => {
        root.remove_preview_row_request(index);
      }
      apply_request => {
        root.apply_request();
      }
      undo_request => {
        root.undo_request();
      }
    }

    if (page_index == 2): IconPanel {
      source_path <=> root.icon_source_path;
      output_path <=> root.icon_output_path;
      status_text <=> root.icon_status_text;
      preview_text <=> root.icon_preview_text;
      preview_rows <=> root.icon_preview_rows;
      language_index <=> root.language_index;
      tr(text_key, is_en) => { return root.tr(text_key, is_en); }

      pick_input_folder(current_path) => { return root.pick_folder(current_path); }
      pick_input_file(current_path) => { return root.pick_icon_file(current_path); }
      pick_output_folder(current_path) => { return root.pick_folder(current_path); }
      scan_request(folder) => {
        root.icon_scan_request(folder);
      }
      extract_request(output) => {
        root.icon_extract_request(output);
      }
      remove_row_request(index) => {
        root.icon_remove_row_request(index);
      }
      clear_request => {
        root.icon_clear_request();
      }
    }

    if (page_index == 6): MarkdownPanel {
      source_path <=> root.markdown_source_path;
      output_path <=> root.markdown_output_path;
      status_text <=> root.markdown_status_text;
      preview_rows <=> root.markdown_preview_rows;
      language_index <=> root.language_index;
      tr(text_key, language) => { return root.tr(text_key, language); }

      pick_input_folder(current_path) => { return root.pick_folder(current_path); }
      pick_input_file(current_path) => { return root.pick_markdown_file(current_path); }
      pick_output_folder(current_path) => { return root.pick_folder(current_path); }
      scan_request(source) => {
        root.markdown_scan_request(source);
      }
      export_request(output) => {
        root.markdown_export_request(output);
      }
      remove_row_request(index) => {
        root.markdown_remove_row_request(index);
      }
      clear_request => {
        root.markdown_clear_request();
      }
    }

    if (page_index == 3): UnlockPanel {
      target_path <=> root.unlock_target_path;
      status_text <=> root.unlock_status_text;
      preview_text <=> root.unlock_preview_text;
      preview_rows <=> root.unlock_preview_rows;
      scanning <=> root.unlock_scanning;
      language_index <=> root.language_index;
      tr(text_key, is_en) => { return root.tr(text_key, is_en); }

      pick_target_file(current_path) => { return root.pick_unlock_file(current_path); }
      pick_target_folder(current_path) => { return root.pick_unlock_folder(current_path); }
      scan_request(target) => {
        root.unlock_scan_request(target);
      }
      release_request => {
        root.unlock_release_request();
      }
      remove_row_request(index) => {
        root.unlock_remove_row_request(index);
      }
      clear_request => {
        root.unlock_clear_request();
      }
    }

    if (page_index == 5): FolderStylePanel {
      folder_path <=> root.folderstyle_folder_path;
      status_text <=> root.folderstyle_status_text;
      preview_text <=> root.folderstyle_preview_text;
      preview_rows <=> root.folderstyle_preview_rows;
      preset_name <=> root.folderstyle_preset_name;
      language_index <=> root.language_index;
      tr(text_key, is_en) => { return root.tr(text_key, is_en); }

      store_request(preset_name) => {
        root.folderstyle_store_request(preset_name);
      }
      show_preset_manager_request => {
        root.folderstyle_show_preset_manager_request();
      }
      pick_folder(current_path) => { return root.pick_folder(current_path); }
      add_request(folder) => {
        root.folderstyle_add_request(folder);
      }
      move_up_request(index) => {
        root.folderstyle_move_up_request(index);
      }
      edit_row_request(index) => {
        root.folderstyle_edit_row_request(index);
      }
      remove_row_request(index) => {
        root.folderstyle_remove_row_request(index);
      }
      clear_request => {
        root.folderstyle_clear_request();
      }
      apply_request => {
        root.folderstyle_apply_request();
      }
    }

    if (page_index == 4): SysenvPanel {
      value_path <=> root.sysenv_value_path;
      preset_name <=> root.sysenv_preset_name;
      variable_name <=> root.sysenv_variable_name;
      status_text <=> root.sysenv_status_text;
      preview_text <=> root.sysenv_preview_text;
      preview_rows <=> root.sysenv_preview_rows;
      language_index <=> root.language_index;
      tr(text_key, is_en) => { return root.tr(text_key, is_en); }

      interaction_request => {
        root.sysenv_interaction_request();
      }
      pick_value_path(current_path) => { return root.pick_folder(current_path); }
      store_request(preset_name) => {
        root.sysenv_store_request(preset_name);
      }
      show_preset_manager_request => {
        root.sysenv_show_preset_manager_request();
      }
      load_system_request => {
        root.sysenv_load_system_request();
      }
      load_user_request => {
        root.sysenv_load_user_request();
      }
      preview_request(value_path, variable_name) => {
        root.sysenv_preview_request(value_path, variable_name);
      }
      edit_row_request(index) => {
        root.sysenv_edit_row_request(index);
      }
      remove_row_request(index) => {
        root.sysenv_remove_row_request(index);
      }
      commit_system_request => {
        root.sysenv_commit_system_request();
      }
      commit_user_request => {
        root.sysenv_commit_user_request();
      }
    }
    }
  }
}


